# Copie para .env. Use senhas fortes e exclusivas; nao versionar .env.
MYSQL_ROOT_PASSWORD=ALTERE_SENHA_ROOT_MYSQL
MYSQL_DATABASE=meubanco
MYSQL_USER=usuario
MYSQL_PASSWORD=ALTERE_SENHA_MYSQL
MSSQL_SA_PASSWORD=ALTERE_SENHA_SQLSERVER_123!
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=ALTERE_SENHA_MONGO
ORACLE_PASSWORD=ALTERE_SENHA_ORACLE_123
POSTGRES_USER=usuario
POSTGRES_PASSWORD=ALTERE_SENHA_POSTGRES
POSTGRES_DB=meubanco
# MCP: habilite somente bancos com credenciais de LEITURA dedicadas
MCP_PG_URL=postgresql+psycopg://leitor:SENHA@localhost:5432/meubanco
MCP_MYSQL_URL=mysql+pymysql://leitor:SENHA@localhost:3306/meubanco
# MCP_MSSQL_URL=mssql+pyodbc://leitor:SENHA@localhost:1433/meubanco?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# MCP_ORACLE_URL=oracle+oracledb://leitor:SENHA@localhost:1521/?service_name=XEPDB1
# MCP_MONGO_URI=mongodb://leitor:SENHA@localhost:27017/meubanco?authSource=meubanco
MCP_MONGO_DB=meubanco
